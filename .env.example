# ============================================================
# 社内FAQ AI — 環境設定
# このファイルを .env にコピーして値を設定してください。
# 何も設定しなくても「抜粋モード」で動作します（デモ可能）。
# ============================================================

# ---- LLMプロバイダ（どちらか一方のキーを設定すればAI回答モードになります）----

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI互換API（OpenAI / Azure OpenAI互換ゲートウェイなど）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 明示的に指定する場合: anthropic | openai | mock（未設定なら自動判定）
LLM_PROVIDER=

# ---- ベクトル検索（任意。OpenAI互換の埋め込みAPIが必要）----
# 1にすると取り込み時に埋め込みを生成し、キーワード検索と併用します。
EMBEDDINGS_ENABLED=0
EMBEDDING_MODEL=text-embedding-3-small

# ---- アクセス制御（インターネット公開時は必ず設定）----
# チャット画面用の共有アクセスコード（未設定なら誰でも利用可 = ローカルデモ用）
ACCESS_CODE=
# 管理画面用パスワード（ACCESS_CODEを設定した場合、これが未設定だと管理画面はロックされます）
ADMIN_PASSWORD=
# 許可するIPアドレスのプレフィックス（カンマ区切り。例: 203.0.113.,198.51.100.7）
IP_ALLOWLIST=
